# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (Defaults to gemini-3.5-flash-lite for high-speed zero-bottleneck generation)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Secondary API key for load balancing / rate limit isolation
# GEMINI_CODER_API_KEY=your_second_api_key_here

# Optional: Vercel Postgres / Neon Database connection string
# POSTGRES_URL=postgres://default:password@ep-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb
